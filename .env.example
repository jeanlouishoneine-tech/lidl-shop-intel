# Lidl Plus API — obtained by running: uv run python src/auth.py
LIDL_REFRESH_TOKEN=

# Lidl Plus locale
LIDL_LANGUAGE=de
LIDL_COUNTRY=DE

# Currency — derived automatically from LIDL_COUNTRY (DE→EUR, CH→CHF, GB→GBP, etc.)
# Override only if auto-detection gives the wrong result
# LIDL_CURRENCY=EUR

# Your usual Lidl store ID — run: uv run python -c "from src.api import fetch_stores; import json; print(json.dumps(fetch_stores()[:5], indent=2))"
# then set the ID of your nearest store here
LIDL_STORE_ID=

# Local AI model served by Ollama (default: llama3.2)
OLLAMA_MODEL=llama3.2
